{
  "namespace": "azelux_introduction_screen",

  // Reference

  "introduction_screen": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {"page_1@azelux_introduction_screen.page_1": {}},
      {"page_2@azelux_introduction_screen.page_2": {}},
      {"page_3@azelux_introduction_screen.page_3": {}},
      {"page_4@azelux_introduction_screen.page_4": {}}
    ]
  },

  "page_1": {
    "type": "panel",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "introduction_screen_page_2",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#visible"
      }
    ],
    "size": [ "100%", "100%" ], // damit die anchor den gesamten bildschirm berechnen können
    "controls": [
      {
        "page_1": {
          "type": "panel",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "introduction_screen_page_1",
              "source_property_name": "(not #toggle_state)",
              "target_property_name": "#visible"
            },
            {
              "binding_type": "view",
              "source_control_name": "introduction_screen_page_3",
              "source_property_name": "(not #toggle_state)",
              "target_property_name": "#visible"
            }
          ],
          "size": [ "100%", "100%" ], // damit die anchor den gesamten bildschirm berechnen können
          "controls": [
            {
              "main_stack_panel": {
                "type": "stack_panel",
                "orientation": "vertical",
                "anchor_from": "center",
                "anchor_to": "center",
                "offset": [0,-30],
                "size": [ "100%", "auto" ], // nimmt die volle breite ein um es horizontal zu zentrieren
                "controls": [
                  {
                    "row_1": {
                      "type": "panel",
                      "size": [ "100%", 12 ],
                      "controls": [
                        {
                          "horizontal_stack": {
                            "type": "stack_panel",
                            "orientation": "horizontal",
                            "anchor_from": "center",
                            "anchor_to": "center",
                            "size": [ "100%c", 12 ], // "100%c" passt die breite exakt an den textinhalt an
                            "controls": [
                              {
                                "label": {
                                  "type": "label",
                                  "font_type": "Roboto-Bold",
                                  "text": "Welcome to Azelux Client, "
                                }
                              },
                              {
                                "gamertag": {
                                  "type": "label",
                                  "font_type": "Roboto-Bold",
                                  "text": "#gamertag_label",
                                  "bindings": [
                                    {
                                      "binding_name": "#gamertag_label"
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "row_2": {
                      "type": "panel",
                      "size": [ "100%", 12 ],
                      "controls": [
                        {
                          "label": {
                            "type": "label",
                            "text_alignment": "left",
                            "font_type": "Roboto-Regular",
                            "text": "If this is the first time you're launching,"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "row_3": {
                      "type": "panel",
                      "size": [ "100%", 12 ],
                      "controls": [
                        {
                          "label": {
                            "type": "label",
                            "text_alignment": "left",
                            "font_type": "Roboto-Regular",
                            "text": "please restart your game"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "spacer": {
                      "type": "panel",
                      "size": [ 8, 8 ]
                    }
                  },
                  {
                    "panel": {
                      "type": "panel",
                      "size": [ "100%", 12 ],
                      "controls": [
                        {
                          "introduction_screen_steps@mod_menu_toggles.mod_menu_tab": {
                            "$azelux_mod_menu_tab": "introduction_screen_page_1",
                            "$toggle_name": "introduction_screen_steps",
                            "$toggle_group_default_selected": 0,
                            "$toggle_group_forced_index": 1,
                            "$mod_toggle_text": "C O N T I N U E",
                            "size": [49,12]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "page_2": {
    "type": "panel",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "introduction_screen_page_1",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ],
    "size": [ "100%", "100%" ], // damit die anchor den gesamten bildschirm berechnen können
    "controls": [
      {
        "azelux_start_screen_modules@azelux_start_screen_modules.content":{
        }
      },
      {
        "label": {
          "type": "label",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "font_type": "Roboto-Bold",
          "offset": [0,3],
          "layer": 10000,
          "text": "First, lets configure a few options to your likings."
        }
      },
      {
        "label": {
          "type": "label",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "font_type": "Roboto-Bold",
          "offset": [0,14],
          "font_scale_factor": 0.85,
          "layer": 10000,
          "text": "You can change this any time, later - however we recommend configuring it now."
        }
      },
      {
        "mod_menu@azelux_client_mod_menu.start_mod_menu": {
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "sigmalolnonexistenttogglebrainrotahhhhskibidi",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ],
          "$ingame_username_ignored": true,
          "$ignore_config_background": true,
          "$config_button_ignored": true,
          "$exit_button_ignored": true,
          "anchor_from": "center",
          "anchor_to": "center",
          "$hotbar_alpha": 0.5
        }
      },
      /*{
        "image": {
          "type": "image",
          "texture": "textures/ui/Black",
          "alpha": 0.65,
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [0,-8.5],
          "size": [52,30],
          "layer": [100]
        }
      },*/
      {
        "introduction_screen_steps@mod_menu_toggles.mod_menu_tab": {
          "$azelux_mod_menu_tab": "introduction_screen_page_2",
          "$toggle_name": "introduction_screen_steps",
          "$toggle_group_default_selected": 0,
          "$toggle_group_forced_index": 2,
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [-10,0],
          "$mod_toggle_text": "C O N T I N U E",
          "size": [49,12],
          "layer": [101]
        }
      },
      {
        "settings_button@cb_buttons.custom_text_button": {
          "$pressed_button_name": "button.menu_settings",
          "$sigma": "S E T T I N G S",
          "$button_text": "",
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "$default_button_texture|default": "azelux/assets/buttons/button_less",
          "$hover_button_texture|default": "azelux/assets/buttons/button_default",
          "$pressed_button_texture|default": "azelux/assets/buttons/button_default",
          "$locked_button_texture|default": "azelux/assets/buttons/button_default",
          "$pressed_no_hover_texture|default": "azelux/assets/buttons/button_default",
          "offset": [-10, -17],
          "size": [49, 15],
          "layer": [101]
        }
      }
    ]
  },

  "page_3": {
    "type": "panel",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "introduction_screen_page_2",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ],
    "size": [ "100%", "100%" ], // damit die anchor den gesamten bildschirm berechnen können
    "controls": [
      {
        "label": {
          "type": "label",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "font_type": "Roboto-Bold",
          "offset": [0,3],
          "layer": 10000,
          "text": "Now, choose your favourite cosmetics."
        }
      },
      {
        "label": {
          "type": "label",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "font_type": "Roboto-Bold",
          "offset": [0,14],
          "font_scale_factor": 0.85,
          "layer": 10000,
          "text": "These will make you look awesome."
        }
      },
      {
        "introduction_screen_steps@mod_menu_toggles.mod_menu_tab": {
          "$azelux_mod_menu_tab": "introduction_screen_page_3",
          "$toggle_name": "introduction_screen_steps",
          "$toggle_group_default_selected": 0,
          "$toggle_group_forced_index": 3,
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [-10,0],
          "$mod_toggle_text": "C O N T I N U E",
          "size": [49,12],
          "layer": [101]
        }
      },
      {
        "settings_button@cb_buttons.custom_text_button": {
          "$pressed_button_name": "button.menu_settings",
          "$sigma": "S E T T I N G S",
          "$button_text": "",
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "$default_button_texture|default": "azelux/assets/buttons/button_less",
          "$hover_button_texture|default": "azelux/assets/buttons/button_default",
          "$pressed_button_texture|default": "azelux/assets/buttons/button_default",
          "$locked_button_texture|default": "azelux/assets/buttons/button_default",
          "$pressed_no_hover_texture|default": "azelux/assets/buttons/button_default",
          "offset": [-10, -17],
          "size": [49, 15],
          "layer": [101]
        }
      },
      {
        "cosmetics_menu@azelux_client_cosmetics_menu.cosmetics_menu": {
          "$exit_button_ignored": true,
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "Ilovetungtungtungsahur",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  "page_4": {
    "type": "panel",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "introduction_screen_page_3",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ],
    "size": [ "100%", "100%" ], // damit die anchor den gesamten bildschirm berechnen können
    "controls": [
      {
        "label": {
          "type": "label",
          "font_type": "Roboto-Bold",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "text": "Finally, let's save your config!",
          "offset": [0,5],
          "layer": 1001
        }
      },
      {
        "label": {
          "type": "label",
          "font_type": "Roboto-Regular",
          "font_scale_factor": 0.85,
          "text": "Take a screenshot of everything visible below",
          "offset": [0,22],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 1001
        }
      },
      {
        "label": {
          "type": "label",
          "font_type": "Roboto-Regular",
          "font_scale_factor": 0.85,
          "text": "and upload it to https://azelux-client.github.io/config",
          "offset": [
            0,
            34
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 1001
        }
      },
      {
        "panel": {
          "type": "panel",
          "offset": [0,-130],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "background": {
                "type": "image",
                "texture": "textures/ui/Black",
                "alpha": 0.95,
                "layer": 3,
                "size": ["200%","200%"],
                "fill": true
              }
            }/*,
            {
              "label": {
                "type": "label",
                "font_type": "Roboto-Regular",
                "font_scale_factor": 0.66,
                "text": "(alternatively you can also type in the code manually)",
                "offset": [0,46],
                "layer": 1001
              }
            }*/
          ]
        }
      },
      {
        "panel": {
          "type": "panel",
          "size": [180,60],
          "controls": [
            {
              "the_code_itself@mods_selection_code.mods_options_stack_panel": {
                "offset": [0,0],
                "anchor_from": "center",
                "anchor_to": "center",
                "layer": 100,
                "$ingame_username_ignored": true,
                "$code_background_ignored": true
              }
            }
          ]
        }
      },
      {
        "label": {
          "type": "label",
          "font_type": "Roboto-Regular",
          "font_scale_factor": 0.7,
          "text": "after you've installed your config, enable it in the settings menu on the right.",
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [0,50],
          "layer": 1001
        }
      },
      {
        "settings_button@cb_buttons.custom_text_button": {
          "$pressed_button_name": "button.menu_settings",
          "$sigma": "S E T T I N G S",
          "$button_text": "",
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "$default_button_texture|default": "azelux/assets/buttons/button_less",
          "$hover_button_texture|default": "azelux/assets/buttons/button_default",
          "$pressed_button_texture|default": "azelux/assets/buttons/button_default",
          "$locked_button_texture|default": "azelux/assets/buttons/button_default",
          "$pressed_no_hover_texture|default": "azelux/assets/buttons/button_default",
          "offset": [-10, -17],
          "size": [49, 15],
          "layer": [5000]
        }
      }
    ]
  }
}