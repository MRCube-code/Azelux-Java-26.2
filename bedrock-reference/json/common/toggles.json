   "light_ui_toggle": {
     "type": "panel",
     "$toggle_view_binding_name|default": "this_toggle",
     "$template_toggle|default": "azelux_toggles.light_template_toggle",
     "controls": [
       {
         "$toggle_view_binding_name@$template_toggle": {
         }
       },
       {
         "Iconsss": {
           "type": "image",
           "anchor_from": "center",
           "anchor_to": "center",
           "offset": [0,0],
           "size": "$icon_size",
           "$icon_size|default": [6.0,6.0],
           "alpha": 0.7,
           "texture":"$icon",
           "ignored": "$ignore_icon",
           "layer": 999
         }
       }
     ]
   },

