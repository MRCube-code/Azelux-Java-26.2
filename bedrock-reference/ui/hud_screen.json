{
  "namespace": "hud",

  "additional_stuff": {
    "type": "panel",
    "controls": [
      {
        "fix_hotbar_scrolling":{
          "type":"input_panel",
          "button_mappings":[
            {
              "from_button_id":"button.inventory_left",
              "to_button_id":"button.hotbar_inventory_left",
              "mapping_type":"global"
            },
            {
              "from_button_id":"button.inventory_right",
              "to_button_id":"button.hotbar_inventory_right",
              "mapping_type":"global"
            }
          ],
          "bindings":[
            {
              "binding_type":"view",
              "source_control_name":"mods_toggle_state",
              "source_property_name":"(not #toggle_state)",
              "target_property_name":"#visible"
            },
            {
              "binding_type":"view",
              "source_control_name":"cosmetics_toggle_state",
              "source_property_name":"(not #toggle_state)",
              "target_property_name":"#visible"
            }
          ]
        }
      }
    ]
  },

  "vignette_renderer": {
    "ignored": true
  },

  "hud_player_renderer": {
    "type": "panel",
    "size": [ 15, 15 ],

    "controls": [
      {
        "hud_player": {
          "type": "custom",
          "renderer": "hud_player_renderer",
          "layer": 1,
          "animation_reset_name": "screen_animation_reset",
          "anims": [
            "@common.screen_exit_size_animation_push",
            "@common.screen_exit_size_animation_pop",
            "@common.screen_entrance_size_animation_push",
            "@common.screen_entrance_size_animation_pop"
          ],
          "offset": [100000],
          "bindings": [
            {
              "binding_name": "#paper_doll_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },

  "chat_grid_item": {
    "type": "panel",
    "layer": 1,
    "size": [ "100%-2px", "100%c" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "chat_main_toggle",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "chat_background": {
          "type": "image",
          "texture": "textures/ui/Black",
          "alpha": "$chat_background_opacity",
          "size": [ "100%", "100%c" ],
          "anims": [
            "@hud.anim_chat_bg_wait"
          ],
          "controls": [
            {
              "chat_text@chat_label": {
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [ 2, 0 ]
              }
            }
          ]
        }
      }
    ]
  },

  "chat_panel": {
    "type": "panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ "100%", "100%c" ],
    "max_size": [ "100%", "50%" ],
    "offset": [0,100],
    "controls": [
      {
        "stack_panel": {
          "type": "stack_panel",
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "offset": [0,100],
          "factory": {
            "name": "chat_item_factory",
            "max_children_size": 50,
            "control_ids": {
              "chat_item": "chat_item@hud.chat_grid_item"
            }
          }
        }
      }
    ]
  },

  "hud_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "azelux_mod_menu_button@azelux_toggles.light_text_toggle_radio_sus_invis": {
              "size": [
                16,
                16
              ],
              "layer": 5,
              "offset": [
                5,
                34
              ],
              "alpha": 0,
              "anchor_from": "top_left",
              "anchor_to": "top_left",
              "$toggle_default_state": false,
              "$icon": "icons/azelux_mods",
              "$toggle_group_forced_index": 0,
              "$toggle_name": "mods_toggle_state",
              "$hover_text_text": "",
              "$hover_text_offset": [
                0,
                10000
              ],
              "$rizzoffset": [
                0,
                10000
              ],
              "$toggle_view_binding_name": "mods_toggle_state",
              "$button_mappings": [
                {
                  "from_button_id": "button.menu_select",
                  "mapping_type": "double_pressed",
                  "to_button_id": "button.menu_select"
                },
                {
                  "from_button_id": "button.menu_ok",
                  "mapping_type": "double_pressed",
                  "to_button_id": "button.menu_ok"
                }
              ]
            }
          },
          {
            "mod_menu@azelux_client_mod_menu.start_mod_menu": {
              "$ingame_username_ignored": false
            }
          },
          {
            "azelux_cosmetics_button@azelux_toggles.light_text_toggle_radio_sus_invis": {
              "size": [
                16,
                16
              ],
              "layer": 5,
              "offset": [
                5,
                50
              ],
              "alpha": 0,
              "anchor_from": "top_left",
              "anchor_to": "top_left",
              "$toggle_default_state": false,
              "$icon": "icons/azelux_cosmetics",
              "$toggle_group_forced_index": 0,
              "$toggle_name": "cosmetics_toggle_state",
              "$hover_text_text": "",
              "$hover_text_offset": [
                0,
                10000
              ],
              "$rizzoffset": [
                0,
                10000
              ],
              "$toggle_view_binding_name": "cosmetics_toggle_state",
              "$button_mappings": [
                {
                  "from_button_id": "button.menu_select",
                  "mapping_type": "double_pressed",
                  "to_button_id": "button.menu_select"
                },
                {
                  "from_button_id": "button.menu_ok",
                  "mapping_type": "double_pressed",
                  "to_button_id": "button.menu_ok"
                }
              ]
            }
          },
          {
            "cosmetics_menu@azelux_client_cosmetics_menu.cosmetics_menu": {
              "bindings": [
                {
                  "binding_type": "view",
                  "source_control_name": "cosmetics_toggle_state",
                  "source_property_name": "#toggle_state",
                  "target_property_name": "#visible"
                }
              ]
            }
          },
          {
            "3@azelux_modules_list.content": {}
          },
          {
            "4@azelux_fullbright.content": {}
          }
        ]
      }
    ]
  },

  "cursor_renderer": {
    "type": "custom",
    "size": [ 16, 16 ],
