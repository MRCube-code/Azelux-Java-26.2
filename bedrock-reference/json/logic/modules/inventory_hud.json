{
  "namespace": "azelux_inventory_hud",
  "inv_hud_container_item": {
    "$stack_count_required": true,
    "$durability_bar_required": true,
    "$storage_bar_required": true,
    "$durability_bar_size": [11, 0.6],
    "type": "panel",
    "size": [15, 15],
    "controls": [
      {
        "bg": {
          "type": "image",
          "texture": "textures/ui/White",
          "color": [0,0,0],
          "alpha": 0.3,
          "size": ["100% - 1px", "100% - 1px"],
          "layer": 1
        }
      },
      {
        "item_panel": {
          "type": "panel",
          "size": [15, 15],
          "layer": 0,
          "controls": [
            {
              "item_renderer": {
                "type": "panel",
                "size": [14, 14],
                "controls": [
                  {
                    "stack_count_label@common.stack_count_label": {
                      "font_scale_factor": 1,
                      "layer": 27
                    }
                  },
                  {
                    "item_renderer@common.item_renderer": {
                      "size": [14, 14],
                      "layer": 7
                    }
                  }
                ]
              }
            },
            {
              "durability_bar@common.durability_bar": {
                "layer": 20
              }
            },
            {
              "storage_bar@common.storage_bar": {
                "layer": 20
              }
            }
          ]
        }
      }
    ]
  },
  "inventory_hud_panel@mod_menu_sliders.movable_mod": {
    "$x_slider": "inventory_hud_position_x",
    "$y_slider": "inventory_hud_position_y",
    "$custom_controls": [
      {
        "inventory_hud_panel_movable": {
          "type": "panel",
          "size": [135, 45],
          "anchor_from": "center",
          "anchor_to": "center",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "inventory_hud_main_toggle",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ],
          "offset": [0, 0],
          "clips_children": true,
          "layer": 45,
          "controls": [
            {
              "inv_grid": {
                "type": "grid",
                "size": [135, 60],
                "anchor_from": "bottom_middle",
                "anchor_to": "bottom_middle",
                "grid_dimensions": [9, 4],
                "grid_item_template": "azelux_inventory_hud.inv_hud_container_item",
                "$item_collection_name": "hotbar_items",
                "collection_name": "$item_collection_name"
              }
            }
          ]
        }
      }
    ]
  }
}