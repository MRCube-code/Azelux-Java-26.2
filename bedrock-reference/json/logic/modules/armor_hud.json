{
  "namespace": "armor_hud_mod",
  "armor_hud_main": {
    "type": "panel",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "armor_hud_main_toggle",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "boots@mod_menu_sliders.movable_mod": {
          "$x_slider": "armor_hud_boots_position_x",
          "$y_slider": "armor_hud_boots_position_y",
          "$custom_controls": [
            {
              "boots": {
                "type": "custom",
                "renderer": "live_player_renderer",
                "size": [
                  18,
                  18
                ],
                "offset": [-7,1035.5]
              }
            }
          ]
        }
      },
      {
        "chestplate@mod_menu_sliders.movable_mod": {
          "$x_slider": "armor_hud_chestplate_position_x",
          "$y_slider": "armor_hud_chestplate_position_y",
          "$custom_controls": [
            {
              "chestplate": {
                "type": "custom",
                "renderer": "live_player_renderer",
                "size": [
                  18,
                  18
                ],
                "offset": [-7,2088]
              }
            }
          ]
        }
      },
      {
        "leggings@mod_menu_sliders.movable_mod": {
          "$x_slider": "armor_hud_leggings_position_x",
          "$y_slider": "armor_hud_leggings_position_y",
          "$custom_controls": [
            {
              "leggings": {
                "type": "custom",
                "renderer": "live_player_renderer",
                "size": [
                  18,
                  18
                ],
                "offset": [-7,-1076]
              }
            }
          ]
        }
      },
      {
        "helmet@mod_menu_sliders.movable_mod": {
          "$x_slider": "armor_hud_helmet_position_x",
          "$y_slider": "armor_hud_helmet_position_y",
          "$custom_controls": [
            {
              "helmet": {
                "type": "custom",
                "renderer": "live_player_renderer",
                "size": [
                  18,
                  18
                ],
                "offset": [-7,-2129.5]
              }
            }
          ]
        }
      }
