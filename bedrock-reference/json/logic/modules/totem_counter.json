  "totem_counter_main_module": {
    "type": "panel",
    "controls": [
      {
        "movable_mod@mod_menu_sliders.movable_mod": {
          "$x_slider": "totem_counter_position_x",
          "$y_slider": "totem_counter_position_y",
          "$custom_controls": [
            {
              "main_stack": {
                "type": "stack_panel",
                "orientation": "horizontal",
                "size": ["100%c", 16],
                "controls": [
                  {
                    "with_bg": {
                      "type": "image",
                      "texture": "textures/ui/Black",
                      "alpha": 0.35,
                      "size": ["100%c + 8px", "100%c + 6px"],
                      "layer": 5,
                      "bindings": [
                        { "binding_type": "view", "source_control_name": "totem_counter_background_toggle", "source_property_name": "#toggle_state", "target_property_name": "#visible" }
                      ],
                      "controls": [ { "inner@azelux_totem_counter.inner_content": {} } ]
                    }
                  },
                  {
                    "no_bg": {
                      "type": "panel",
                      "size": ["100%c + 8px", "100%c + 6px"],
                      "layer": 5,
                      "bindings": [
                        { "binding_type": "view", "source_control_name": "totem_counter_background_toggle", "source_property_name": "(not #toggle_state)", "target_property_name": "#visible" }
                      ],
                      "controls": [ { "inner@azelux_totem_counter.inner_content": {} } ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "inner_content": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": ["100%c", "100%cm"],
    "layer": 10,
    "controls": [
      { "label": { "type": "label", "text": "Totems: ", "shadow": true, "layer": 20 } },
      { "padding": { "type": "panel", "size": [2, 1] } },
      { "count@azelux_totem_counter.azelux_total_item_count": { "$item_id": 449, "layer": 20 } }
    ]
  }
}
