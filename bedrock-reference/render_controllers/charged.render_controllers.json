{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.charged": {
      "geometry": "geometry.charged",
      "materials": [ { "*": "material.charged" } ],
      "textures": [ "texture.players" ],
      "uv_anim": {
          "offset": [ "-(math.floor(query.life_time * 20.0) + query.frame_alpha) * 0.01",
                      "-(math.floor(query.life_time * 20.0) + query.frame_alpha) * 0.01" ],
          "scale": [ 0.9, 0.9 ]
      },
      "light_color_multiplier": 0.5,
      "ignore_lighting" : true,
      "is_hurt_color": {},
      "on_fire_color": {}
      }
    }
  }