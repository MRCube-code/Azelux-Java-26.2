{
  "namespace": "azelux_client_shields",

  "shields_menu": {
    "type": "panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [
      "12%",
      "4%"
    ],
    "controls": [
      {
        "button_list_row_1@azelux_client_shields.button_list_row_1": {
          "anchor_from": "top_left",
          "anchor_to": "top_left"
        }
      },
      {
        "button_list_row_2@azelux_client_shields.button_list_row_2": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [0,30]
        }
      },
      {
        "button_list_row_3@azelux_client_shields.button_list_row_3": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [0,60]
        }
      }
    ]
  },

  "button_list_row_1": {
