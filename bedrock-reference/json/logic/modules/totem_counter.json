{
  "namespace": "azelux_totem_counter",

  "azelux_item_amount": {
    "type": "panel",
    "size": [0, 0],
    "$item_id|default": 449,
    "bindings": [
      { "binding_name": "#item_id_aux", "binding_type": "collection", "binding_collection_name": "hotbar_items" },
      { "binding_name": "#inventory_stack_count", "binding_type": "collection", "binding_collection_name": "hotbar_items" },
      { "binding_type": "view", "source_property_name": "(((65536 * $item_id) = ((#item_id_aux / 65536 + 0) * 65536)) + 0)", "target_property_name": "#available" },
      { "binding_type": "view", "source_property_name": "(#inventory_stack_count + 0)", "target_property_name": "#real_item_count" },
      { "binding_type": "view", "source_property_name": "(#available * #real_item_count)", "target_property_name": "#count" }
    ]
  },

