  "all_mods_list": {
    "type": "panel",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "mods_list_main_toggle",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "stack_panel": {
          "type": "stack_panel",
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [3,3],
          "orientation": "vertical",
          "controls": [
            {"custom_crosshair@template_text": {"$mod_main_toggle": "custom_crosshair_main_toggle","text": "Custom Crosshair"}},
            {"durability_viewer@template_text": {"$mod_main_toggle": "durability_viewer_main_toggle","text": "Durability Viewer"}},
            {"server_address@template_text": {"$mod_main_toggle": "server_address_main_toggle","text": "Server Address"}},
            {"chunk_borders@template_text": {"$mod_main_toggle": "chunk_border_main_toggle","text": "Chunk Borders"}},
            {"inventory_hud@template_text": {"$mod_main_toggle": "inventory_hud_main_toggle","text": "Inventory Hud"}},
            {"glint_colorizer@template_text": {"$mod_main_toggle": "glint_colorizer_main_toggle","text": "Glint Colorizer"}},
            {"moving_status@template_text": {"$mod_main_toggle": "moving_status_main_toggle","text": "Moving Status"}},
            {"direction_hud@template_text": {"$mod_main_toggle": "direction_hud_main_toggle","text": "Direction Hud"}},
            {"offhand_hud@template_text": {"$mod_main_toggle": "offhand_hud_main_toggle","text": "Offhand Hud"}},
            {"chat@template_text": {"$mod_main_toggle": "chat_main_toggle","text": "Bottom Chat"}},
            {"armor_hud@template_text": {"$mod_main_toggle": "armor_hud_main_toggle","text": "Armor Hud"}},
            {"shiny_pots@template_text": {"$mod_main_toggle": "shiny_pots_main_toggle","text": "Shiny Pots"}},
            {"left_hand@template_text": {"$mod_main_toggle": "left_hand_main_toggle","text": "Left Hand"}},
            {"fullbright@template_text": {"$mod_main_toggle": "fullbright_main_toggle","text": "Fullbright"}},
            {"chunkmap@template_text": {"$mod_main_toggle": "chunkmap_main_toggle","text": "Chunkmap"}},
            {"mods_list@template_text": {"$mod_main_toggle": "mods_list_main_toggle","text": "Mods List"}},
            {"hitbox@template_text": {"$mod_main_toggle": "hitbox_main_toggle","text": "Hitboxes"}},
            {"hit_color@template_text": {"$mod_main_toggle": "hit_color_main_toggle","text": "Hit Color"}},
            {"tab_list@template_text": {"$mod_main_toggle": "tab_list_main_toggle","text": "Tab List"}},
            {"f8_screen@template_text": {"$mod_main_toggle": "f8_screen_main_toggle","text": "F8 Menu"}},
            {"framex@template_text": {"$mod_main_toggle": "framex_main_toggle","text": "FrameX"}}
