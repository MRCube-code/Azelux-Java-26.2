{
  "namespace": "mods_list_mod",

  "template_text": {
    "type": "label",
    "color": "$custom_color",
    "alpha": "$custom_alpha",
    "font_scale_factor": 1,
    "size": [ "default", 10 ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "$mod_main_toggle",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

